<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Target Name="GenerateWorkflow" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract.py&quot; &quot;$(MSBuildProjectDirectory)/../../../EmuLunch2&quot; &quot;$(IntermediateOutputPath)Workflow.g.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Workflow.g.cs" />
    </ItemGroup>
  </Target>
</Project>
