    CONVERT(varchar ,T1.Tel_CustNo) AS CUSTOMER_NO
    ,M1.得意先名 AS CUSTOMER_NAME
    ,T1.Tel_TelNo AS TELNO
  FROM
    C_TelToCust T1
    LEFT OUTER JOIN 得意先マスタ M1 ON
      T1.企業ＣＤ = M1.企業ＣＤ AND
      T1.Tel_CustNo = M1.得意先ＣＤ
